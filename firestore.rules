rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reemplaza por el UID de tu usuario administrador
    // (Firebase Console → Authentication → Usuarios → columna "UID de usuario").
    function esAdmin() {
      return request.auth != null && request.auth.uid in ['YTs6W2StpUOSYYbFvqO8Ca47eMI2'];
    }

    function votoValido(d) {
      return d.keys().hasOnly(['carita', 'fecha', 'mes', 'origen'])
        && d.keys().hasAll(['carita', 'fecha', 'mes', 'origen'])
        && d.carita in ['Malo', 'Regular', 'Bueno', 'Excelente']
        && d.fecha is string && d.fecha.size() <= 30
        && d.mes is string && d.mes.matches('^[0-9]{4}-[0-9]{2}$')
        && d.origen in ['web', 'kiosco'];
    }

    match /votos/{votoId} {
      // Cualquiera puede votar, pero solo con datos válidos
      allow create: if votoId.size() <= 40 && votoValido(request.resource.data);
      // Reenvío del mismo voto (reintento tras un corte): se acepta solo si no cambia nada
      allow update: if request.resource.data == resource.data;
      // Solo el administrador ve los resultados
      allow read: if esAdmin();
      allow delete: if false;
    }
  }
}
